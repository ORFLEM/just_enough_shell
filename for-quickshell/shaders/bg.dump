#version 100

struct buf
{
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float patternScale;
    float evolutionSpeed;
    vec2 resolution;
    vec4 accent;
    vec4 dark;
    vec4 mid;
};

uniform buf _232;

varying vec2 qt_TexCoord0;

vec2 hash2(vec2 p)
{
    ivec2 q = ivec2(p);
    q *= ivec2(1597334673, -482951495);
    q = ivec2(q.x ^ q.y) * ivec2(1597334673, -482951495);
    return ((vec2(q) * 2.3283064365386962890625e-10) * 2.0) - vec2(1.0);
}

float perlin2D(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = ((f * f) * f) * ((f * ((f * 6.0) - vec2(15.0))) + vec2(10.0));
    vec2 param = i + vec2(0.0);
    vec2 ga = hash2(param);
    vec2 param_1 = i + vec2(1.0, 0.0);
    vec2 gb = hash2(param_1);
    vec2 param_2 = i + vec2(0.0, 1.0);
    vec2 gc = hash2(param_2);
    vec2 param_3 = i + vec2(1.0);
    vec2 gd = hash2(param_3);
    float va = dot(ga, f - vec2(0.0));
    float vb = dot(gb, f - vec2(1.0, 0.0));
    float vc = dot(gc, f - vec2(0.0, 1.0));
    float vd = dot(gd, f - vec2(1.0));
    return (mix(mix(va, vb, u.x), mix(vc, vd, u.x), u.y) * 0.5) + 0.5;
}

float perlin4D(vec2 p, float w)
{
    vec2 param = p + vec2(w * 100.0, w * 73.0);
    float n1 = perlin2D(param);
    vec2 param_1 = p + vec2((-w) * 89.0, w * 137.0);
    float n2 = perlin2D(param_1);
    float blend = fract(w);
    blend = (blend * blend) * (3.0 - (2.0 * blend));
    return mix(n1, n2, blend);
}

float fbm4D(vec2 p, float w)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    for (int i = 0; i < 2; i++)
    {
        vec2 param = p * frequency;
        float param_1 = w;
        value += (amplitude * perlin4D(param, param_1));
        frequency *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

void main()
{
    vec2 uv = qt_TexCoord0;
    uv.x *= (_232.resolution.x / _232.resolution.y);
    float w = _232.time * _232.evolutionSpeed;
    vec2 p = uv * _232.patternScale;
    vec2 param = p;
    float param_1 = w;
    float n = fbm4D(param, param_1);
    float contour_value = fract(n * 35.0);
    float line = step(contour_value, 0.02700000070035457611083984375) + step(0.972999989986419677734375, contour_value);
    line = clamp(line, 0.0, 1.0);
    vec3 bg = _232.dark.xyz;
    vec3 fg = mix(_232.mid.xyz, _232.accent.xyz, vec3(0.60000002384185791015625));
    vec3 color = mix(bg, fg, vec3(line));
    gl_FragData[0] = vec4(color, 1.0) * _232.qt_Opacity;
}



