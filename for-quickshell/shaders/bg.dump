    float n = fbm4D(param, param_1);
    float contour_value = fract(n * 35.0);
    float line = step(contour_value, 0.02700000070035457611083984375) + step(0.972999989986419677734375, contour_value);
    line = fast::clamp(line, 0.0, 1.0);
    float3 bg = _232.dark.xyz;
    float3 fg = mix(_232.mid.xyz, _232.accent.xyz, float3(0.60000002384185791015625));
    float3 color = mix(bg, fg, float3(line));
    out.fragColor = float4(color, 1.0) * _232.qt_Opacity;
    return out;
}



